{
  // The order gateway. It holds the Kalshi private key and the Alpaca key and secret
  // as Worker secrets so the Sail VM that runs the desks never has them: the VM can ask
  // for an order, but only this Worker can authenticate one, and only within the caps below.
  //
  // Secrets, set with `npx wrangler secret put <NAME>` and never written to this file:
  //   KALSHI_KEY_ID, KALSHI_PRIVATE_KEY, ALPACA_KEY_ID, ALPACA_SECRET_KEY,
  //   GATEWAY_TOKEN, GATEWAY_ADMIN_TOKEN, SAIL_API_KEY.
  //
  // It is also the floor's supervisor. Every five minutes it reads the published checkpoint, the
  // Sail credit balance and the state of the box, resumes and restarts the box when it can, and
  // mails the owner only when it cannot -- so the single human step left is adding Sail credit.
  "name": "ltcm-gateway",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": { "bindings": [{ "name": "GATE", "class_name": "Gate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gate"] }],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "blakewoods98@gmail.com",
      "allowed_sender_addresses": ["agent@blakewoods.us"]
    }
  ],
  "vars": {
    // Hard caps, in US dollars. A cap is only ever lowered by editing this file and redeploying,
    // which is a change the owner makes, not a change the VM can make.
    // Sized so a desk's own limits bind first: Hilibrand may put half its sleeve into one
    // order, Mullins fifteen percent. A quoting strategy replaces its resting bids as fair
    // moves, so a day holds a few hundred small orders; the dollar caps still bind the risk.
    // Sept 18, 2026 (the arena): the owner accepts the loss of the whole account; the caps now
    // bound a runaway loop, not a position. Exits (X-LTCM-Purpose: exit) skip the dollar caps.
    // Sept 19, 2026 (the rebuild): two accounts of about $800 each. One order is never more
    // than a tenth of an account, and a day's submitted notional is a few times the floor's
    // capital because resting quotes are replaced as prices move. Exits skip the dollar caps.
    "MAX_ORDER_USD": "75",
    "MAX_ORDER_USD_KALSHI": "75",
    "MAX_ORDER_USD_ALPACA": "75",
    "MAX_DAY_USD": "4000",
    "MAX_DAY_ORDERS": "2000",
    // The frontier model's month, in dollars. The owner raises it when the return earns it.
    "FRONTIER_MONTH_USD": "100",
    // Dollars per million tokens: input, cached input, output. A model absent here is refused.
    // From developers.openai.com/api/docs/pricing on Sept 19, 2026. Input is priced at the
    // cache-write rate, the dearest an input token can be, so the meter errs high.
    "FRONTIER_MODELS": "{\"gpt-6-astra\": {\"input\": 12.5, \"cached\": 1.0, \"output\": 50}, \"gpt-5.6-sol\": {\"input\": 5.0, \"cached\": 0.4, \"output\": 20}, \"gpt-5.6-terra\": {\"input\": 2.5, \"cached\": 0.2, \"output\": 12}}",
    // Trade notices a day (one per live fill and settlement). Sept 17, 2026: 40 held the day's
    // notices from noon on once three live favorites desks were filling.
    "NOTIFY_MAX_PER_DAY": "300",
    // The calendar the daily counters roll on: the floor's own trading day.
    "CAP_TIMEZONE": "America/New_York",

    // Watchdog.
    "CHECKPOINT_URL": "https://blakewoods.us/api/capital/checkpoint",
    // A single inline model turn may legitimately take up to 25 minutes (FOREGROUND_TIMEOUT);
    // the watchdog must not restart a box that is merely thinking.
    "CHECKPOINT_STALE_SECONDS": "1800",
    "RESTART_COOLDOWN_SECONDS": "1800",
    "RESTART_COMMAND": "/workspace/restart.sh",
    // Set to the Sailbox id once the box exists. Empty means the watchdog only reports.
    "SAILBOX_ID": "sb_d36bc830-0d04-4761-8898-0ff4daa199dc",

    // Funding and mail. Sail's `range` understands 1h/6h/24h/7d/30d/period and silently falls
    // back to 30d for anything else, so "a day" is spelled 24h.
    "SAIL_USAGE_RANGE": "24h",
    "LOW_BALANCE_USD": "60",
    "CRITICAL_BALANCE_USD": "20",
    "ALERT_EVERY_SECONDS": "21600",
    "ALERT_FROM": "agent@blakewoods.us",
    "ALERT_TO": "blakewoods98@gmail.com"
  },
  "observability": { "enabled": false }
}

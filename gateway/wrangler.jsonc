{
  // The order gateway. It holds the Kalshi private key, both Alpaca key pairs (real and paper),
  // the OpenAI key and the GitHub token as Worker secrets so the Sail VM that runs the House never
  // has them: the VM can ask for an order, a frontier call or a pull request, but only this
  // Worker can authenticate one, and only within the caps below.
  //
  // Secrets, set from gateway/ with `npx wrangler secret put <NAME>` and never written to this
  // file (`npx wrangler secret list` prints the names that are placed):
  //   KALSHI_KEY_ID, KALSHI_PRIVATE_KEY,
  //   ALPACA_KEY_ID, ALPACA_SECRET_KEY            the real account, venue `alpaca`
  //   ALPACA_PAPER_KEY_ID, ALPACA_PAPER_SECRET_KEY  the paper account, venue `alpaca-paper`
  //   OPENAI_SECRET_KEY                           /v1/frontier/*
  //   TYPE_SAFE_TOKEN                             the bounded Jev shadow pilot
  //   GITHUB_TOKEN (fine-grained, this one repository, Contents and Pull requests read/write)
  //   GATEWAY_TOKEN                               the runtime's bearer token, 32+ characters
  //   GATEWAY_ADMIN_TOKEN                         the owner's; the only token /v1/unkill accepts
  //   SAIL_API_KEY                                the watchdog; without it the watchdog only reports
  // Mail needs no secret: it goes out through the EMAIL binding below. The first run's
  // COINBASE_KEY_NAME and COINBASE_API_SECRET are obsolete (`npx wrangler secret delete <NAME>`).
  //
  // It is also the box's supervisor. Every five minutes it reads the PRODUCTION checkpoint, the
  // Sail credit balance and the state of the House box, resumes and restarts the box when it can,
  // and mails the owner when it cannot -- so the single human step left is adding Sail credit.
  // While the production tape is empty (404) it resumes and restarts nothing. Which release of
  // the code the box runs is the in-box watchdog's business (league/watchdog.py), not this one's.
  "name": "ltcm-gateway",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": { "bindings": [{ "name": "GATE", "class_name": "Gate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gate"] }],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "blakewoods98@gmail.com",
      "allowed_sender_addresses": ["agent@blakewoods.us"]
    }
  ],
  "vars": {
    // Hard caps, in US dollars. A cap is only ever lowered by editing this file and redeploying,
    // which is a change the owner makes, not a change the VM can make.
    // History: the first run sized these so a desk's own limits bound first, and on Sept 18,
    // 2026 (the arena) raised them to bound a runaway loop rather than a position.
    // Sept 19, 2026 (the rebuild, in force): two accounts of about $800 each. One order is never
    // more than a tenth of an account, and a day's submitted notional is a few times the floor's
    // capital because resting quotes are replaced as prices move. An order sent with
    // `X-LTCM-Purpose: exit` skips the dollar caps; the paper venue is never metered at all.
    "MAX_ORDER_USD": "75",
    "MAX_ORDER_USD_KALSHI": "75",
    "MAX_ORDER_USD_ALPACA": "75",
    "MAX_DAY_USD": "4000",
    "MAX_DAY_ORDERS": "2000",
    // Sept 21: $104.14 already metered plus $75 owner-reported remaining credit, less ~$5
    // operating reserve. This is an aggregate ceiling, not a fresh $174 allowance.
    // Sept 21 22:15 UTC: the owner added $200 of OpenAI credit -> $374.
    // Sept 23 06:40 UTC: $308.46 metered this month and the owner reports about $100 of OpenAI
    // credit funded, so the month is aligned to metered + funded, rounded down -> $408.
    "FRONTIER_MONTH_USD": "408",
    // Owner increased the classification experiment to $20, fully backed by retained phase holds. No reset
    // by month or restart. No production trading/release decision consumes these answers.
    // Sept 23 06:40 UTC: $16.14 metered and the owner reports $26 funded at Jev -> metered +
    // funded, rounded down: $42.
    "TYPESAFE_PILOT_USD": "42",
    "TYPESAFE_PILOT_END": "2026-09-21T11:01:16.977Z",
    // Continue unused original allowance after the owner resumed the game. No resets or refills.
    "TYPESAFE_PERSISTENT": "true",
    // Dollars per million tokens: input, cached input, output. A model absent here is refused.
    // From developers.openai.com/api/docs/pricing on Sept 19, 2026. Input is priced at the
    // cache-write rate, the dearest an input token can be, so the meter errs high. `uncached` is
    // the list rate for a token neither read nor written (1/1.25 of the write rate, prompt-caching
    // guide, Sept 22, 2026); it applies only when the usage block reports `cache_write_tokens`.
    // GPT-6 Sol and Luna from their Sept 22, 2026 launch: Sol $2 plain / $0.20 cached / $10 output,
    // Luna $0.10 / $0.01 / $0.50; writes 1.25x plain; above 272K input tokens input and cache
    // rates double and output is 1.5x. Both ids were reachable with the key on Sept 22, 2026
    // (GET /v1/frontier/models).
    "FRONTIER_MODELS": "{\"gpt-6-astra\":{\"input\":12.5,\"cached\":1,\"output\":50,\"long_input\":25.0,\"long_cached\":2,\"long_output\":75.0,\"uncached\":10,\"long_uncached\":20},\"gpt-5.6-sol\":{\"input\":5,\"cached\":0.4,\"output\":20,\"long_input\":10,\"long_cached\":0.8,\"long_output\":30.0,\"uncached\":4,\"long_uncached\":8},\"gpt-5.6-terra\":{\"input\":2.5,\"cached\":0.2,\"output\":12,\"long_input\":5.0,\"long_cached\":0.4,\"long_output\":18.0,\"uncached\":2,\"long_uncached\":4},\"gpt-5.6-luna\":{\"input\":0.25,\"cached\":0.02,\"output\":1.2,\"long_input\":0.5,\"long_cached\":0.04,\"long_output\":1.7999999999999998,\"uncached\":0.2,\"long_uncached\":0.4},\"gpt-6-sol\":{\"input\":2.5,\"cached\":0.2,\"output\":10,\"long_input\":5.0,\"long_cached\":0.4,\"long_output\":15.0,\"uncached\":2,\"long_uncached\":4},\"gpt-6-luna\":{\"input\":0.125,\"cached\":0.01,\"output\":0.5,\"long_input\":0.25,\"long_cached\":0.02,\"long_output\":0.75,\"uncached\":0.1,\"long_uncached\":0.2}}",
    // Where the frontier model's proposals become pull requests, and how many may open in one
    // UTC day. The token that opens them is the secret GITHUB_TOKEN; without it the route is a
    // 503. Nothing here merges: CI judges a pull request and a repository workflow merges it.
    "GITHUB_REPO": "bwoods1998/long-term-capital-management",
    "GITHUB_MAX_PULLS_PER_DAY": "96",
    // Trade notices a day (one per live fill and settlement). Sept 17, 2026: 40 held the day's
    // notices from noon on once three live favorites desks were filling.
    "NOTIFY_MAX_PER_DAY": "300",
    // The calendar the daily counters roll on: the floor's own trading day.
    "CAP_TIMEZONE": "America/New_York",

    // Watchdog.
    "CHECKPOINT_URL": "https://blakewoods.us/api/capital/checkpoint",
    // A single inline model turn may legitimately take up to 25 minutes (FOREGROUND_TIMEOUT);
    // the watchdog must not restart a box that is merely thinking.
    "CHECKPOINT_STALE_SECONDS": "1800",
    "RESTART_COOLDOWN_SECONDS": "1800",
    "RESTART_COMMAND": "/workspace/restart.sh",
    // Set to the Sailbox id once the box exists. Empty means the watchdog only reports.
    "SAILBOX_ID": "sb_d36bc830-0d04-4761-8898-0ff4daa199dc",

    // Funding and mail. Sail's `range` understands 1h/6h/24h/7d/30d/period and silently falls
    // back to 30d for anything else, so "a day" is spelled 24h.
    "SAIL_USAGE_RANGE": "24h",
    "LOW_BALANCE_USD": "60",
    "CRITICAL_BALANCE_USD": "20",
    "ALERT_EVERY_SECONDS": "21600",
    "ALERT_FROM": "agent@blakewoods.us",
    "ALERT_TO": "blakewoods98@gmail.com"
  },
  "observability": { "enabled": false }
}

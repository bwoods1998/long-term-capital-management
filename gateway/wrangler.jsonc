// Options gateway. Credentials are Worker secrets; see README.md. Owner-funded caps are explicit.
{
  "name": "ltcm-gateway",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GATE",
        "class_name": "Gate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Gate"
      ]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "blakewoods98@gmail.com",
      "allowed_sender_addresses": [
        "agent@blakewoods.us"
      ]
    }
  ],
  "vars": {
    "MAX_DAY_USD_ALPACA": "10000",
    "MAX_DAY_ORDERS": "300",
    "MAX_DAY_OPEN_ORDERS": "250",
    "MAX_ORDER_MAX_LOSS_USD": "1000",
    "MAX_ORDER_EQUITY_SHARE": "0.15",
    "MAX_DAY_EQUITY_SHARE": "1.0",
    "CREDIT_MIN_EQUITY_USD": "2000",
    "EQUITY_CAP_MAX_AGE_MS": "120000",
    "FRONTIER_MONTH_USD": "707",
    "FRONTIER_FUNDED_MONTH": "2026-09",
    "FRONTIER_MODELS": "{\"gpt-6-astra\":{\"input\":12.5,\"cached\":1,\"output\":50,\"long_input\":25.0,\"long_cached\":2,\"long_output\":75.0,\"uncached\":10,\"long_uncached\":20,\"flex\":{\"input\":6.25,\"cached\":0.5,\"output\":25,\"long_input\":12.5,\"long_cached\":1,\"long_output\":37.5,\"uncached\":5,\"long_uncached\":10}},\"gpt-5.6-sol\":{\"input\":5,\"cached\":0.4,\"output\":20,\"long_input\":10,\"long_cached\":0.8,\"long_output\":30.0,\"uncached\":4,\"long_uncached\":8},\"gpt-5.6-terra\":{\"input\":2.5,\"cached\":0.2,\"output\":12,\"long_input\":5.0,\"long_cached\":0.4,\"long_output\":18.0,\"uncached\":2,\"long_uncached\":4},\"gpt-5.6-luna\":{\"input\":0.25,\"cached\":0.02,\"output\":1.2,\"long_input\":0.5,\"long_cached\":0.04,\"long_output\":1.7999999999999998,\"uncached\":0.2,\"long_uncached\":0.4},\"gpt-6-sol\":{\"input\":2.5,\"cached\":0.2,\"output\":10,\"long_input\":5.0,\"long_cached\":0.4,\"long_output\":15.0,\"uncached\":2,\"long_uncached\":4,\"flex\":{\"input\":1.25,\"cached\":0.1,\"output\":5,\"long_input\":2.5,\"long_cached\":0.2,\"long_output\":7.5,\"uncached\":1,\"long_uncached\":2}},\"gpt-6-luna\":{\"input\":0.125,\"cached\":0.01,\"output\":0.5,\"long_input\":0.25,\"long_cached\":0.02,\"long_output\":0.75,\"uncached\":0.1,\"long_uncached\":0.2,\"flex\":{\"input\":0.0625,\"cached\":0.005,\"output\":0.25,\"long_input\":0.125,\"long_cached\":0.01,\"long_output\":0.375,\"uncached\":0.05,\"long_uncached\":0.1}}}",
    "FRONTIER_ROLE_MAX_OUTPUT": "{\"postmortem\":64000}",
    "GITHUB_REPO": "bwoods1998/long-term-capital-management",
    "GITHUB_MAX_PULLS_PER_DAY": "96",
    "NOTIFY_MAX_PER_DAY": "300",
    "CAP_TIMEZONE": "America/New_York",
    "OPTION_STRUCTURES_REAL": "off",
    "CHECKPOINT_URL": "https://blakewoods.us/api/capital/checkpoint",

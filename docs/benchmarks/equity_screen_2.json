{
 "name": "equity_screen_2",
 "screen": "S2",
 "study": "SSCREEN2-1010 share screen S2 (worlds where Validation and holdout never share a session), adopted Oct 10, 2026 as amendment A11 with its review's fixes (exact F1 floor, no joint 2-D floor, c_R 0)",
 "replaces": "the gate of equity_screen_1 (S1+F1). Receipt 1 is not edited and stays pinned for S1. The series, the pre-check, the S1-X label, D3, D6 and the no-feedback rule carry over unchanged.",
 "rule": "S2 (share screen), per program, one holdout look per lineage. Series as receipt 1: the program's daily P&L r_t on its equity E0 (constant weights at the goal's caps: ETF <= 0.50, stock <= 0.20, sum <= 1.00; half-spread 1 bp index ETFs / 3 bp others; SEC and FINRA TAF sell fees), effective exposure w_t, round trips RT (full exits) and invested days ID (a position held at the close). Pre-check (Validation, calendar 2025, 250 sessions): (RT >= 20 or ID >= 120) and sum_V r > 1e-12. Look (once, only after a passed pre-check): sum_H r > 1e-12 AND t_H = mean_H(r) / sd_H(r, ddof 1) x sqrt(L) >= c_H,used; a holdout sd below 1e-12 fails. c_R = 0: the pooled t over Validation + holdout is not a bar (a positive Validation sum and a positive holdout sum already make it positive). c_H,used = max(c_H_floor, c_pF1 + c_H_margin) on the 0.01 grid, where c_pF1 is the program's own F1 point by exact enumeration (floor). Label S1-X unchanged from receipt 1: the same pre-check and pooled t on x_t = r_t - w_t * mean_W(b) (b = equal-weight cost-free benchmark of the program's universe, W = the window) >= c_X, no floor: pass = alpha, fail = beta; never a gate.",
 "fp_cap": 0.12,
 "owner_wall": 0.15,
 "c_R": 0.0,
 "c_H_floor": 0.95,
 "c_H_margin": 0.05,
 "c_X": 0.85,
 "precheck": {
  "rt_min": 20,
  "id_min": 120,
  "rule": "(RT_V >= 20 or ID_V >= 120) and sum_V(r) > 1e-12"
 },
 "look": {
  "rule": "pre-check passed AND sum_H(r) > 1e-12 AND t_H >= c_H,used; t_H = mean_H / sd_H(ddof 1) x sqrt(L), undefined (fails) when sd_H < 1e-12",
  "c_H_used": "max(c_H_floor, c_pF1 + c_H_margin), in grid steps max(round(100 c_H_floor), k_F1 + round(100 c_H_margin)); a c_H,used above 5.00 makes the program ineligible",
  "pooled_t": "report only, never a condition (c_R = 0)"
 },
 "floor": {
  "method": "exact",
  "c_pF1": "the largest, over the program's eligible floor cells (world set x L in {194, 251}), of each cell's smallest c on 0.00..5.00 (step 0.01) with P(sum_H r0 > 1e-12 AND sd_H >= 1e-12 AND t_H >= c) <= fp_cap, the probability taken exactly over the cell's world distribution (no pre-check)",
  "world_sets": {
   "IND22-NO": "pieces [the 2022-01-03..2024-12-31 pool]; eligible when that pool has >= 550 sessions",
   "IND1622-NO": "pieces [the 2016-01-04..2019-12-31 pool, the 2022-01-03..2024-12-31 pool]; eligible when each pool has >= 251 sessions"
  },
  "pools": "the program's own series on each Train-era span (2016-01-04..2019-12-31, 2022-01-03..2024-12-31), from its first decision + 2 sessions to the span's last session; no 2020, 2021, 2025 or 2026 session",
  "worlds": "a world is a Validation block V of 250 and a holdout block H of L consecutive sessions, each circular inside one piece, V and H sharing no session (in one piece of length n: (start_H - start_V) mod n in [250, n - L]); every valid (piece_V, start_V, piece_H, start_H) tuple is equally likely (the distribution of the study's IND-NO rejection sampler)",
  "enumeration": "per piece k of length n_k: U_k = valid H starts per V start, W_k = valid V starts per H start (the other pieces' lengths that can hold the block, plus max(0, n_k - 250 - L + 1) in the same piece); T = the number of valid tuples; the holdout-only count at c = the sum of W_k over the H starts meeting the condition; rate = count / T, compared with fp_cap in exact integer arithmetic",
  "null": "N0 per role: r0 = r - w kappa_role, kappa_V = sum_k U_k sum(r) / sum_k U_k sum(w), kappa_H = sum_k W_k sum(r) / sum_k W_k sum(w) (inclusion-weighted, review D4)",
  "ineligible": "no eligible set, a cell with no valid tuple or no c <= 5.00, c_H,used above 5.00, zero exposure, a non-finite series, or a session outside the Train-era spans",
  "seeds": "none: the floor is an exact enumeration (deterministic; review fix 3)",
  "own_rates": "computed on the House by the same enumeration at c_H,used, the largest over the floor cells, never committed: own FP (the S2 gate under N0), the holdout-only rate (N0), and the drift-kept rate (the gate under N1: r - w (kappa_role - m_role), m_role the inclusion-weighted mean of b)"
 },
 "windows": {
  "validation": "calendar 2025 (250 sessions)",
  "holdout": "2026-01-02 .. 2026-10-09: exactly 194 sessions (the look cap, which replaces review fix D6's 2026-12-31); later sessions are forward days only",
  "calibrated_L": "the floor covers L 194 and 251; with a fixed 194-session holdout the L 251 cells only make c_pF1 conservative"
 },
 "lineage": {
  "holdout_looks": 1,
  "validation_tries": 2,
  "retry": "only after the first try FAILED its pre-check (no look spent), with the retry version hashed at the first try (R3)",
  "same_lineage": "a program whose Train daily returns correlate >= 0.7 with a program already looked at, or that uses the same template, is the same lineage (review fix D3)",
  "no_feedback": "look and Validation outcomes of share programs are never fed back to generators or the diagnostician (review fix D3)"
 },

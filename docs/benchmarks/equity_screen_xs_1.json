{
 "name": "equity_screen_xs_1",
 "screen": "XS1",
 "study": "XSCREEN-1 (xscreen-1011): XS1, the panel screen (daily residual over matched placebo portfolios); pre-registration revision 2 pinned 2026-10-11T03:03:08Z",
 "rule": "XS1 (panel screen), per program, one holdout look per lineage. Series: the daily RESIDUAL x_t = the program's P&L after its costs on E0 (constant-weight lot accounting) minus the cost-free P&L of each lot's matched cell (sector x beta third x 12-1 momentum third, fixed at the lot's decision date). Pre-check on Validation: (RT_V >= 20 or ID_V >= 120) and sum_V(x) > 1e-12. Look on the holdout (194 sessions): pass = pre-check AND sum_H(x) > 1e-12 AND sum_H(x15) > 1e-12 AND t_H >= c_used AND p_plac <= 0.12, with t_H = mean_H(x) / sd_H(x, ddof 1) x sqrt(194), c_used = max(c_XS, c_p + 0.05), c_p the program's own exact floor, and p_plac = (1 + #{999 matched placebo portfolios with t_H >= the program's}) / 1000.",
 "contract": {
  "name": "C-XS-1",
  "long_only": true,
  "max_weight": 0.2,
  "max_sum": 1.0,
  "max_names": 40,
  "min_notional_usd": 10,
  "keep_rule": "a held slot with a positive target is kept (no trade, no resize); a held slot absent from the target is sold whole; a new slot is bought as one lot",
  "max_buys": 12,
  "max_sells": 12,
  "fills": "decide at the close of d; fill in session d + 1 at the declared open or close; a lot is never sold in the session it was bought; max_hold_sessions <= 60",
  "costs": "half-spread 3 bp on every fill; SEC fee and FINRA TAF on sells, each rounded up to the cent per order; no commission",
  "E0": 1000,
  "house_exits": "a held name not in U(d) at a session close is sold at the next open; the same exit law binds every placebo counterpart and cell member",
  "ctx": "no ticker, no name, no date, no price level, no size or liquidity rank; scale-free per-slot fields, statistical sector and beta"
 },
 "fp_cap": 0.12,
 "owner_wall": 0.15,
 "c_XS": 1.3,
 "c_margin": 0.05,
 "alpha_plac": 0.12,
 "placebo_draws": 999,
 "stratum": {
  "rung": "R0",
  "definition": "sector = the sector fund (of those with at least 200 valid returns) whose market-residual returns correlate most with the name's over the 252 sessions to d; beta = OLS on the market fund over the same window (at least 200 valid returns); momentum = c(d - 21) / c(d - 252) - 1. Per sector of n names: (beta groups, momentum groups) = (3, 3) when n >= 45, (2, 2) when 20-44, (1, 2) when 10-19, (1, 1) when 5-9; sectors of 4 or fewer names share one pooled cell. Names sorted by (beta, asset id) into beta groups floor(q nb / n), then within a beta group by (momentum, asset id) into floor(q nm / m).",
  "min_cell": 5,
  "window": 252,
  "min_valid": 200,
  "funds": [
   "XLB",
   "XLE",
   "XLF",
   "XLI",
   "XLK",
   "XLP",
   "XLU",
   "XLV",
   "XLY",
   "XLRE",
   "XLC"
  ],
  "market": "SPY"
 },
 "residual": {
  "definition": "per lot: cost-free leg returns of every cell member (open entry c/o - 1 at half exposure, held c/c - 1, open exit o/c_prev - 1 at half exposure, close exit c/c_prev - 1); B_t = sum over lots of weight x the mean leg return of the lot's cell members valid that session; x_t = r_t - B_t with r_t the program's P&L after spread and sell fees; x15_t = x_t - 0.5 s_t - f_t; the cell member list is fixed at the decision close (less members failing entry validity) for the lot's life; a member that leaves the eligible set takes the open-exit leg the next session and then drops out of the mean; an invalid own-name leg is neutral",
  "placebo_law": "each draw gives every lot a counterpart in its cell; decisions in time order; counterparts of lots exiting at the next fill are released; cells in ascending id, lots within a cell by (weight descending, asset id ascending); one uniform key per member, keys of members the draw already holds raised by 2, the k smallest keys become the counterparts in order; the placebo series is cost-free",
  "seed_rule": "numpy default_rng(int.from_bytes(sha256('XS1|' + receipt sha256 + '|' + program code sha256 + '|placebo').digest()[:16], 'big')); one rng.random((999, members)) call per decision and cell; fixed before the look"
 },
 "precheck": {
  "rt_min": 20,
  "id_min": 120,
  "rule": "(RT_V >= 20 or ID_V >= 120) and sum_V(x) > 1e-12; a failed pre-check spends no look and spends the lineage's try"
 },
 "look": {
  "rule": "pre-check AND sum_H(x) > 1e-12 AND sum_H(x15) > 1e-12 AND t_H >= c_used AND p_plac <= 0.12 (placebo count <= 119 of 999); t_H undefined (fails) when sd_H < 1e-12 or not finite",
  "c_used": "max(c_XS, c_p + 0.05) on the 0.01 grid: k_used = max(k_XS, k_p + 5); k_used > 500 is INELIGIBLE",
  "stress": "sum_H x15 > 1e-12, x15 = x - 0.5 s - f (1.5 times the half-spread, each sell fee twice)"
 },
 "floor": {
  "method": "exact",
  "statistic": "t_H of the daily residual x, L = 194",
  "cells": "(i) both Train-era pools together when both exist with at least 251 sessions each; (ii) each single pool of at least 550 sessions alone",
  "pools": "the program's own (x, w) on 2016-01-04..2019-12-31 and 2022-01-03..2024-12-31, from its first decision + 2 sessions",
  "worlds": "every holdout block of 194 consecutive pool sessions, circular inside one pool, weighted by its number of non-overlapping Validation blocks",
  "null": "N0: x0 = x - w kappa_H, kappa_H = sum_k W_k sum(x) / sum_k W_k sum(w)",
  "ineligible": "no floor cell; a cell with no tuple weight; a cell with no k in 0..500 holding 12%; zero exposure; a non-finite series; a session outside the spans; k_used > 500",
  "own_rate": "own_fp = the largest over the floor cells of HO[k_used] / T; IN-SAMPLE (at most 12% by construction), no placebo leg; computed on the House, never committed",
  "k_cell": "the smallest k in 0..500 with HO[k] x 100 <= 12 x T; k_p = the largest k_cell; c_p = k_p / 100"
 },
 "eligibility": {
  "program": "a panel program under contract C-XS-1 with at least one floor cell and k_used <= 500; no look when INELIGIBLE or when the pre-check fails",
  "universe": "U(d): index member on d, d + 1, d + 2; accepted series with a valid close on d and d - 1; the eligible class of its company; beta, momentum and sector defined (253 sessions of history)",
  "entry": "a valid open and close at the fill session and a valid close the session after"
 },
 "windows": {
  "validation": "calendar 2025 (250 sessions)",
  "holdout": "2026-01-02 .. 2026-10-09: exactly 194 sessions; later sessions are forward days only",
  "calibrated_L": 194
 },
 "lineage": {
  "holdout_looks": 1,
  "validation_tries": 1,
  "same_lineage": "the same template, or a Train daily correlation of 0.7 or more with a program already looked at or already refused at the pre-check, in either series: the residual x or the universe excess u (the residual computed with one cell holding all of U(d))",
  "series": [
   "x",
   "u"
  ],
  "no_feedback": "Validation, look, placebo-rank and forward outcomes of panel programs are never fed to a generator",
  "routes": "a lineage that took an XS1 look can take no S2 look, and the reverse; the forward route F-GS-XS is specified in the pre-registration and not measured here"
 },
 "R3_retry_permitted": false,
 "labels": {
  "basket": "'basket-led' when the sum over V and H of B_t >= the sum over V and H of x_t, else 'selection-led'",
  "french": "OLS of x on (Mkt-RF, SMB, HML, Mom, ST_Rev) daily over V and the covered part of H (at least 120 days, else 'unmeasured'); 'style-loaded: <factors with |t| >= 2.0>' or 'no style loading found'; never a gate"
 },

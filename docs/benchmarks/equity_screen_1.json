{
 "name": "equity_screen_1",
 "study": "SSCREEN-1010 share screen S1, adopted Oct 10, 2026 with its review's fixes F1, D3, D5, D6",
 "rule": "S1 (share screen), per program, one Validation try and one holdout look per lineage. Series: the program's daily P&L r_t on its equity E0 (constant weights at the goal's caps: ETF <= 0.50, stock <= 0.20, sum <= 1.00; half-spread 1 bp index ETFs / 3 bp others; SEC and FINRA TAF sell fees), effective exposure w_t, round trips RT (full exits) and invested days ID (a position held at the close). Step 0 (floor): c_p = the smallest c on the 0.01 grid with the program's pass rate <= 12% on 20,000 independent-block null worlds of its own 2022-24 series (N0: r - w*kappa, kappa = sum r / sum w over the pool), at holdout lengths 194 and 251 (the larger); c_used = max(c_R, c_p). Step 1 (pre-check, Validation window, 250 sessions): (RT >= 20 or ID >= 120) and sum r > 1e-12. Step 2 (after the one look): pooled t over the Validation + holdout daily r (mean / sd(ddof 1) * sqrt(n)) >= c_used and holdout sum r > 1e-12; sd < 1e-12 fails. Label S1-X: the same steps on x_t = r_t - w_t * mean_W(b) (b = equal-weight cost-free benchmark of the program's universe, W = the window), threshold c_X, no floor: pass = alpha, fail = beta.",
 "fp_cap": 0.12,
 "owner_wall": 0.15,
 "c_R": 1.49,
 "c_X": 0.85,
 "precheck": {
  "rt_min": 20,
  "id_min": 120,
  "rule": "(RT_V >= 20 or ID_V >= 120) and sum_V(r) > 1e-12"
 },
 "look": {
  "rule": "pooled t over V+H daily r >= c_used and sum_H(r) > 1e-12 and t_H >= c_H (holdout-only guard F1); sd < 1e-12 fails"
 },
 "floor": {
  "c_p": "smallest c on 0.00..5.00 (step 0.01) with share(t* >= c) <= fp_cap at BOTH L = 194 and L = 251; c_used = max(c_R, c_p)",
  "c_H": "smallest c on the same grid with share(t_H >= c and sum_H > 0) <= fp_cap on the program's own null worlds, at both L (review fix F1: bounds FP whatever Validation shows, since 2025 is known to authors)",
  "worlds": "IND22: 20,000 worlds, V = 250 and H = L consecutive sessions, independent uniform starts, circular in the program's own 2022-01-03..2024-12-31 pool; and IND1622 (2016-01-04..2019-12-31 plus 2022-01-03..2024-12-31) where the program has that history; c_p and c_H are the maxima over the world sets (review fix D5)",
  "null": "N0: r0 = r - w * kappa, kappa = sum_pool(r) / sum_pool(w)",
  "seed": "numpy default_rng([20261010, 1010, set_id, L, 0]); set_id 3 = IND22, 5 = IND1622",
  "ineligible": "no pool of >= 300 sessions, or c_p > 5.00 or c_H > 5.00"
 },
 "windows": {
  "validation": "calendar 2025 (250 sessions)",
  "holdout": "2026-01-02 .. min(the last close before the look, 2026-12-31) (review fix D6); calibrated for 194..251 sessions"
 },
 "lineage": {
  "holdout_looks": 1,
  "validation_tries": 2,
  "retry": "only after the first try FAILED its pre-check (no look spent), with the retry version hashed at the first try (R3)",
  "same_lineage": "a program whose Train daily returns correlate >= 0.7 with a program already looked at, or that uses the same template, is the same lineage (review fix D3)",
  "no_feedback": "look and Validation outcomes of share programs are never fed back to generators or the diagnostician (review fix D3)"
 },

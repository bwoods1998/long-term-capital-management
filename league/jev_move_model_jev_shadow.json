 "numeric": [
  {
   "name": "mid",
   "definition": "(yes_bid+yes_ask)/2"
  },
  {
   "name": "spread",
   "definition": "yes_ask-yes_bid"
  },
  {
   "name": "log_oi",
   "definition": "log1p(max(0,open_interest))/15, 0 if missing"
  },
  {
   "name": "hours",
   "definition": "min(max(hours_to_close,0),48)/48, 1 if missing"
  },
  {
   "name": "drift",
   "definition": "mid minus the mid of earlier_quotes[0] (the oldest of up to four prior minute buckets), 0 if none"
  },
  {
   "name": "absdrift",
   "definition": "abs(drift)"
  },
  {
   "name": "ext",
   "definition": "abs(mid-0.5)*2"
  },
  {
   "name": "lvol",
   "definition": "log1p(max(0,volume_24h))/15, 0 if missing"
  },
  {
   "name": "lhrs",
   "definition": "log1p(max(hours_to_close,0))/log1p(720), not clamped, 1 if missing"
  },
  {
   "name": "hres",
   "definition": "min(max(hours_to_resolve,0),48)/48, 1 if missing"
  },
  {
   "name": "nhist",
   "definition": "len(earlier_quotes)/4"
  },
  {
   "name": "chg4",
   "definition": "E = earlier_quotes (oldest first; the last <= 4 recorded minute quotes before observed_minute); S = [mid of each quote in E..., mid]; number of consecutive pairs in S whose values differ by more than 1e-9, divided by 4 (0 if E is empty)"
  },
  {
   "name": "rng4",
   "definition": "E = earlier_quotes (oldest first; the last <= 4 recorded minute quotes before observed_minute); S = [mid of each quote in E..., mid]; max(S)-min(S)"
  },
  {
   "name": "tchg",
   "definition": "H = the recorder's own recorded minute quotes of this market with observed < observed_minute (one quote per market and minute bucket, first seen wins, recorded from every markets: snapshot as the lab's semantic_quotes; keep >= 4 h); mid of a quote = (bid+ask)/2. Walk H from its newest quote backwards while observed_minute-observed <= 14400 s; at the first quote whose mid differs by more than 1e-9 from the mid of the quote after it (the current mid for the newest quote), T = (observed_minute - observed of that later quote, or 0 if the later one is the current quote)/60. If no such quote is found, T = (observed_minute - observed of the oldest quote visited)/60, or 0 if none was visited. T = min(T,240). Feature = log1p(T)/log1p(240)"
  },
  {
   "name": "nochg",
   "definition": "1 if the tchg walk found no mid change (including an empty H), else 0"
  },
  {
   "name": "rng60",
   "definition": "H = the recorder's own recorded minute quotes of this market with observed < observed_minute (one quote per market and minute bucket, first seen wins, recorded from every markets: snapshot as the lab's semantic_quotes; keep >= 4 h); mid of a quote = (bid+ask)/2. max-min of {mid of every quote in H with observed_minute-observed <= 3600 s} together with the current mid"
  },
  {
   "name": "tight",
   "definition": "1 if spread <= 0.01+1e-9 else 0"
  },
  {
   "name": "pinned",
   "definition": "1 if yes_bid <= 0.01+1e-9 or yes_ask >= 0.99-1e-9 else 0"
  },

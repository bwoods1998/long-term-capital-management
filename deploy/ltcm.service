[Unit]
Description=Long Term Capital Management floor service (desks, risk engine, committee, publisher)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h/Work/portfolio-agent
ExecStart=%h/Work/portfolio-agent/.venv/bin/python -m ltcm run
Restart=on-failure
RestartSec=60
TimeoutStopSec=120
KillSignal=SIGTERM
Nice=5

[Install]
WantedBy=default.target
